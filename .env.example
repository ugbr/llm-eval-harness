# Copy to .env and fill in. .env is gitignored, this file is not.

# Anthropic. Set a hard monthly spend cap in the console before running anything.
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse Cloud. Host is region-specific, check which one your project is on.
#   EU: https://cloud.langfuse.com
#   US: https://us.cloud.langfuse.com
#   JP: https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# Optional. Only used to turn a trace id into a clickable link while reviewing calls. Without it
# the review surface prints the bare trace id, which is still enough to find one by hand.
# It is the id in the URL when you have a Langfuse project open: /project/<this>/traces/...
LANGFUSE_PROJECT_ID=
